# Copia questo file in .env e cambia almeno le due password.
#   cp .env.example .env

# --- database ---------------------------------------------------
DB_NAME=ilomonitor
DB_USER=ilomonitor
DB_PASSWORD=cambia-questa-password
DB_ROOT_PASSWORD=cambia-anche-questa

# --- interfaccia ------------------------------------------------
# Porta sull'host. L'interfaccia parla HTTP: se la esponi oltre la
# rete di gestione, mettici davanti un reverse proxy con TLS.
HTTP_PORT=8080

# --- primo accesso ----------------------------------------------
# Lasciando ADMIN_PASSWORD vuota ne viene generata una casuale,
# stampata una sola volta nei log del servizio api.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- raccolta ---------------------------------------------------
# Ogni quanti minuti interrogare gli iLO. Con molti server conviene
# alzarlo: inventario ed eventi si rileggono comunque piu' di rado.
COLLECT_INTERVAL_MINUTES=5

# Secondi di attesa per ogni richiesta Redfish.
REDFISH_TIMEOUT=30
